NODE_ENV=production
PORT=4000

# Redis (service name from docker-compose)
REDIS_HOST=redis
REDIS_PORT=6379

# ThingsBoard (service name from docker-compose)
# Method 1: Username/password JWT auth (recommended)
THINGSBOARD_BASE_URL=http://thingsboard:8080
THINGSBOARD_USERNAME=tenant@thingsboard.org
THINGSBOARD_PASSWORD=tenant

# Method 2: Static token fallback (leave as-is to use username/password above)
THINGSBOARD_ACCESS_TOKEN=OPTIONAL_STATIC_TOKEN
