# ThingsBoard Integration Environment Variables
# Copy this file to .env in your backend root directory

# =============================================================================
# THINGSBOARD CONFIGURATION (Required)
# =============================================================================

# ThingsBoard server base URL (required)
# For local development: http://localhost:8080
# For production: https://your-thingsboard-instance.com
THINGSBOARD_BASE_URL=http://localhost:8080

# =============================================================================
# AUTHENTICATION METHODS
# Choose ONE of the following authentication methods:
# =============================================================================

# METHOD 1: Username/Password Authentication (RECOMMENDED for production)
# Used for JWT token-based authentication with automatic refresh
THINGSBOARD_USERNAME=tenant@thingsboard.org
THINGSBOARD_PASSWORD=tenant

# METHOD 2: Static Access Token Authentication (fallback/development)
# Use this if you have a static access token
# Note: Static tokens don't refresh automatically
THINGSBOARD_ACCESS_TOKEN=OPTIONAL_STATIC_TOKEN

# =============================================================================
# CONFIGURATION NOTES
# =============================================================================

# 1. Username/Password method is preferred as it provides:
#    - JWT tokens with automatic refresh
#    - Better security through token expiration
#    - Compatibility with ThingsBoard CE and PE
#
# 2. Static Token method is useful for:
#    - Development and testing
#    - Service accounts with long-lived tokens
#    - Quick prototyping
#
# 3. Configuration validation:
#    - THINGSBOARD_BASE_URL is always required
#    - Either (THINGSBOARD_USERNAME + THINGSBOARD_PASSWORD) OR THINGSBOARD_ACCESS_TOKEN must be provided
#    - If THINGSBOARD_USERNAME is set, THINGSBOARD_PASSWORD is required

# =============================================================================
# EXAMPLE CONFIGURATIONS
# =============================================================================

# Production Example (JWT Authentication):
# THINGSBOARD_BASE_URL=https://thingsboard.your-company.com
# THINGSBOARD_USERNAME=service-account@your-company.com
# THINGSBOARD_PASSWORD=secure-service-password
# # THINGSBOARD_ACCESS_TOKEN=  # Leave commented out

# Development Example (Static Token):
# THINGSBOARD_BASE_URL=http://localhost:8080
# # THINGSBOARD_USERNAME=  # Leave commented out
# # THINGSBOARD_PASSWORD=  # Leave commented out
# THINGSBOARD_ACCESS_TOKEN=eyJhbGciOiJIUzUxMiJ9..example-token

# =============================================================================
# OTHER APPLICATION ENVIRONMENT VARIABLES
# =============================================================================

# Application settings
PORT=3000
NODE_ENV=development

# Database settings (if needed)
# DATABASE_URL=postgresql://user:password@localhost:5432/iotrix_platform

# Redis settings (if needed)
# REDIS_URL=redis://localhost:6379